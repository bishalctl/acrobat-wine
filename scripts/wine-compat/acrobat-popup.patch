@@ -431,6 +431,30 @@
 }
 
 
+/* Acrobat's layered AVL_AVWindow coachmarks are owned, borderless popups.
+ * Promoting them to managed windows on activation lets an X11 window manager
+ * decorate and reposition them independently of their document. Preserve
+ * their popup geometry and Win32 ownership, without changing real dialogs
+ * or floating tool windows.
+ */
+static BOOL is_acrobat_popup( HWND hwnd, DWORD style, DWORD ex_style )
+{
+    static const WCHAR popup_class[] = {'A','V','L','_','A','V','W','i','n','d','o','w',0};
+    WCHAR buffer[32];
+    UNICODE_STRING name = {0, sizeof(buffer), buffer};
+
+    if (!(style & WS_POPUP) || (style & (WS_CAPTION | WS_THICKFRAME | WS_SYSMENU)))
+        return FALSE;
+    if (!(ex_style & WS_EX_LAYERED) ||
+        (ex_style & (WS_EX_APPWINDOW | WS_EX_DLGMODALFRAME | WS_EX_TOOLWINDOW)))
+        return FALSE;
+    if (!NtUserGetWindowRelative( hwnd, GW_OWNER )) return FALSE;
+    if (NtUserGetClassName( hwnd, FALSE, &name ) != ARRAY_SIZE(popup_class) - 1)
+        return FALSE;
+    return !memcmp( buffer, popup_class, sizeof(popup_class) - sizeof(WCHAR) );
+}
+
+
 /***********************************************************************
  *		is_window_managed
  *
@@ -444,6 +468,8 @@
